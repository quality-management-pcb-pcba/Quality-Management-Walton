rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'admin') ||
        request.auth.token.email == 'atiqur40736@waltonbd.com'
      );
    }

    function isManager() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'manager')
      );
    }

    // User accounts collection
    match /users/{userId} {
      // Any authenticated user can read their own profile; admins and managers can read all
      allow read: if isOwner(userId) || isManager();

      // Only admins can update other users' roles or status
      // Users can update their own non-sensitive profile info (name, phone) but not their role or status
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'email', 'employeeId'])
      );

      // Account creation: allow initial bootstrap of superadmin or user's own creation
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) && (
          request.auth.token.email == 'atiqur40736@waltonbd.com' ||
          request.resource.data.role in ['viewer', 'qa_staff']
        ))
      );

      // Deletions restricted to administrators
      allow delete: if isAdmin();
    }

    // Default catch-all for quality records: read for authenticated users, write for qa_staff/manager/admin
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role in ['admin', 'manager', 'qa_staff'])
      );
    }
  }
}
